      "fieldConfig": { "defaults": { "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(llm_ttft_seconds_bucket{mode=\"real\"}[5m])) by (le))",
          "legendFormat": "p50 TTFT",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_ttft_seconds_bucket{mode=\"real\"}[5m])) by (le))",
          "legendFormat": "p95 TTFT",
          "refId": "B"
        }
      ]
    },
    {
