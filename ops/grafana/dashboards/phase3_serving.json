    {
      "type": "text",
      "title": "Phase 3 notice",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**Three layers.** `mode=\"simulated\"` is the CPU mock. FastAPI `llm_*` series are client-side. `vllm:*` series exist only when Prometheus scrapes the engine (`ops/prometheus.gpu.yml`). An empty vLLM panel means the series was not scraped, not that the value is zero. Histogram quantiles are bucket estimates; exact percentiles come from `bench/` request records."
      },
      "id": 1
    },
    {
      "type": "timeseries",
      "title": "API requests/sec",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(llm_requests_total{status=\"success\"}[1m]))",
          "legendFormat": "success",
          "refId": "A"
        },
        {
          "expr": "sum(rate(llm_requests_total{status=\"rejected\"}[1m]))",
          "legendFormat": "rejected",
          "refId": "B"
        },
        {
          "expr": "sum(rate(llm_requests_total{status=\"error\"}[1m]))",
          "legendFormat": "error",
          "refId": "C"
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "API latency p50/p95/p99 (bucket estimate)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(llm_request_latency_seconds_bucket{mode=\"real\"}[2m])) by (le))",
          "legendFormat": "p50 real",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_request_latency_seconds_bucket{mode=\"real\"}[2m])) by (le))",
          "legendFormat": "p95 real",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(llm_request_latency_seconds_bucket{mode=\"real\"}[2m])) by (le))",
          "legendFormat": "p99 real",
          "refId": "C"
        }
      ],
      "id": 3
    },
