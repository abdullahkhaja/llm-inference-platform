# Local default — CPU mock (no GPU / no paid cloud)
BACKEND=mock
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Input limits
MAX_QUESTION_CHARS=2000
MAX_SCHEMA_CHARS=20000
MAX_NEW_TOKENS=256
DEFAULT_MAX_NEW_TOKENS=128

# Mock timing model (milliseconds) — SIMULATED only
MOCK_PREFILL_MS=40
MOCK_PER_TOKEN_MS=12
MOCK_JITTER_MS=2
MOCK_SEED=42

# Request JSONL log path (inside container: /app/logs/requests.jsonl)
REQUEST_LOG_PATH=logs/requests.jsonl
LOG_PROMPTS=false

# Runpod API key (recommended) — https://console.runpod.io/user/settings
# Used by local MCP / runpodctl; never commit the real value.
RUNPOD_API_KEY=

# --- Phase 2: remote vLLM (RunPod). Weights stay on the GPU pod. ---
# Create a read token at https://huggingface.co/settings/tokens
# Accept the Llama 3.1 license on the base model page (gated).
HF_TOKEN=
MODEL_PATH=meta-llama/Llama-3.1-8B-Instruct
ADAPTER_PATH=your-hf-username/your-private-adapter-repo
ADAPTER_SUBFOLDER=sft/final

# FastAPI → remote OpenAI-compatible vLLM
# BACKEND=vllm
VLLM_BASE_URL=http://127.0.0.1:8001/v1
VLLM_MODEL_NAME=spider-sft
VLLM_API_KEY=EMPTY
VLLM_TIMEOUT_S=120
VLLM_CONNECT_TIMEOUT_S=10
VLLM_MAX_RETRIES=2
VLLM_TEMPERATURE=0
VLLM_READY_TIMEOUT_S=30

# GPU compose only (ops/runpod) — unused for local mock
MAX_MODEL_LEN=2048
GPU_MEMORY_UTILIZATION=0.85
MAX_LORA_RANK=16
# Explicit vLLM 0.8.5 flag. true -> --enable-prefix-caching, false -> --no-enable-prefix-caching
ENABLE_PREFIX_CACHING=true

# API admission. false keeps Phase 2 forwarding (no extra queue).
ADMISSION_ENABLED=false
MAX_CONCURRENT_REQUESTS=4
MAX_WAITING_REQUESTS=8
MAX_QUEUE_WAIT_MS=2000

# Optional OpenTelemetry. Off for benchmarks unless you are measuring the trace path.
TRACING_ENABLED=false
# OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Grafana
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin
